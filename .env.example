# Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=
# "anon" / publishable anahtar: tarayıcıya gitmesi güvenlidir, yetkiyi RLS kontrol eder.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Veritabanı bağlantısı (Supabase › Connect › Transaction pooler, port 6543).
# Uygulama her sorguyu giriş yapan kullanıcının kimliğiyle çalıştırır (RLS). ASLA NEXT_PUBLIC_ ile başlamaz.
DATABASE_URL=

# İlk yöneticiler (virgülle ayrılmış). Yükleme/seed script'leri bu e-postaları admin olarak davet listesine ekler.
INITIAL_ADMIN_EMAILS=affanbugraozaytas@gmail.com

# Sadece yerel geliştirme: e-postayla giriş (production'da hiçbir koşulda çalışmaz).
# DEV_AUTH=1
